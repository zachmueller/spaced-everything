{
	"name": "spaced-everything",
	"version": "1.3.5",
	"description": "Apply spaced repetition algorithms to everything in your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node --test \"tests/*.test.cjs\"",
		"e2e": "playwright test --config=e2e/playwright.config.ts",
		"e2e:run": "tsx e2e/run-and-collect.ts",
		"e2e:run:quick": "tsx e2e/run-and-collect.ts --duration 10",
		"e2e:setup-vault": "tsx e2e/scripts/setup-vault.ts",
		"e2e:typecheck": "tsc -p e2e --noEmit"
	},
	"keywords": [],
	"author": "Zach Mueller",
	"license": "MIT",
	"devDependencies": {
		"@playwright/test": "^1.58.0",
		"@types/node": "^20.19.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"playwright-core": "^1.58.0",
		"tslib": "2.4.0",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3"
	}
}
